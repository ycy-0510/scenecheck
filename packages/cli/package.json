{
  "name": "@scenecheck/cli",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "scenecheck": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@scenecheck/core": "workspace:*",
    "@scenecheck/three": "workspace:*"
  },
  "devDependencies": {
    "three": "^0.185.1"
  }
}
